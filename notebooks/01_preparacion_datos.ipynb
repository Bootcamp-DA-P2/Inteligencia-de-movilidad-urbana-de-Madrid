      "Fecha: (365, 8)\n",
      "Sensor: (5088, 9)\n"
     ]
    }
   ],
   "source": [
    "print(f\"Fact: ({fact.select(pl.len()).collect().item()}, {len(fact.collect_schema().names())})\")\n",
    "print(f\"Fecha: ({fecha.select(pl.len()).collect().item()}, {len(fecha.collect_schema().names())})\")\n",
    "print(f\"Sensor: ({sensor.select(pl.len()).collect().item()}, {len(sensor.collect_schema().names())})\")"
