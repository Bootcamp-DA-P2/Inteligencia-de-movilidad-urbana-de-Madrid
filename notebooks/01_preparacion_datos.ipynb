       "└───────────┴─────────────────────────┘"
      ]
     },
     "execution_count": 20,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "df.group_by(\"tipo_elem\").agg([\n",
    "    pl.col(\"velocidad_media\")\n",
    "      .filter(pl.col(\"velocidad_media\") > 0)\n",
    "      .len()\n",
    "      .alias(\"registros_con_velocidad\")\n",
    "]).collect()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 21,
   "id": "b4ceea0b",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Tratamiento inicial de la velocidad\n",
    "\n",
    "df = df.with_columns([\n",
    "\n",
    "    pl.when(pl.col(\"tipo_elem\") == \"URB\")\n",
    "      .then(0)\n",
    "      .when(pl.col(\"velocidad_media\") < 0)\n",
    "      .then(None)\n",
    "      .otherwise(pl.col(\"velocidad_media\"))\n",
    "      .alias(\"velocidad_media\"),\n",
    "\n",
    "    pl.when(pl.col(\"tipo_elem\") == \"URB\")\n",
    "      .then(0)\n",
    "      .when(pl.col(\"velocidad_min\") < 0)\n",
    "      .then(None)\n",
    "      .otherwise(pl.col(\"velocidad_min\"))\n",
    "      .alias(\"velocidad_min\")\n",
    "\n",
    "])"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "4d69b11b",
   "metadata": {},
   "source": [
    "Se normalizan las variables velocidad_media y velocidad_min aplicando dos reglas: para los elementos de tipo URB se asigna el valor 0, ya que la velocidad no resulta representativa, y los valores negativos se reemplazan por null al considerarse datos no válidos. El resto de los registros se mantienen sin cambios."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 22,
   "id": "63435da9",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Calcular la mediana por sensor\n",
    "\n",
    "medianas = (\n",
    "    df.group_by(\"id_sensor\")\n",
    "      .agg([\n",
    "          pl.col(\"velocidad_media\").median().alias(\"mediana_media\"),\n",
    "          pl.col(\"velocidad_min\").median().alias(\"mediana_min\")\n",
    "      ])\n",
    ")\n",
    "\n",
    "df = df.join(medianas, on=\"id_sensor\", how=\"left\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 23,
   "id": "2e59dcf3",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Imputar los nulos con la mediana del sensor\n",
    "\n",
    "df = df.with_columns([\n",
    "\n",
    "    pl.col(\"velocidad_media\")\n",
    "      .fill_null(pl.col(\"mediana_media\"))\n",
    "      .alias(\"velocidad_media\"),\n",
    "\n",
    "    pl.col(\"velocidad_min\")\n",
    "      .fill_null(pl.col(\"mediana_min\"))\n",
    "      .alias(\"velocidad_min\")\n",
    "\n",
    "]).drop([\"mediana_media\", \"mediana_min\"])"
   ]
