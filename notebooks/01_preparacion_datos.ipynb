   "source": [
    "# Carga lazy con scan_parquet() para optimizar el rendimiento en datasets grandes.\n",
    "fact = pl.scan_parquet(\"../data/gold/fact_trafico_hora.parquet\")\n",
    "fecha = pl.scan_parquet(\"../data/gold/dim_fecha.parquet\")\n",
