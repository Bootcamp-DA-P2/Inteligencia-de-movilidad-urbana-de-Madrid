   "source": [
    "## 3. Validación antes del join"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 10,
   "id": "cb1d43f4",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Sensores fact: 4933\n",
      "Sensores dimensión: 5088\n"
     ]
    }
   ],
   "source": [
    "# Obtener el número de sensores únicos en cada tabla\n",
    "sensores_fact = fact.select(pl.col(\"id_sensor\").n_unique()).collect().item()\n",
    "sensores_dim = sensor.select(pl.col(\"id_sensor\").n_unique()).collect().item()\n",
    "\n",
    "print(f\"Sensores fact: {sensores_fact}\")\n",
    "print(f\"Sensores dimensión: {sensores_dim}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 11,
   "id": "14db908b",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "0\n"
     ]
    }
   ],
   "source": [
    "# Sensores presentes en la tabla de hechos y ausentes en la dimensión\n",
    "sensores_fact_set = set(fact.select(\"id_sensor\").unique().collect()[\"id_sensor\"])\n",
    "sensores_dim_set = set(sensor.select(\"id_sensor\").unique().collect()[\"id_sensor\"])\n",
    "\n",
    "sensores_faltantes = sensores_fact_set - sensores_dim_set\n",
    "print(len(sensores_faltantes))"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "ac020785",
   "metadata": {},
   "source": [
    "## 4. Integración de tablas"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 12,
   "id": "b4e5280b",
   "metadata": {},
   "outputs": [],
   "source": [
    "df = (\n",
    "    fact\n",
    "    .join(fecha, on=\"id_fecha\", how=\"left\")\n",
    "    .join(sensor, on=\"id_sensor\", how=\"left\")\n",
    ")"
   ]
  },
  {
